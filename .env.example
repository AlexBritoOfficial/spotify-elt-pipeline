# Spotify API — register an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REFRESH_TOKEN=your_refresh_token   # added once the OAuth flow is set up
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Last.fm API — genre/tag enrichment. Create a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# Postgres — read by docker-compose.yml and the load/transform layers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spotify
POSTGRES_PORT=5432
